# ─── PanelMind environment configuration ─────────────────────────
#
# Copy this file to `.env` and fill in the values you need.
# All variables are validated at startup; missing required keys will
# fail fast with a helpful error message.
#
# ──────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────
# Public URL of the deployed web app. Used by OAuth callbacks and
# email links.
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign NextAuth session tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# CORS: comma-separated list of origins allowed to call the API.
# In dev this is http://localhost:3000. In production, your real
# domain only. DO NOT use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────
# Repository backend. Set to "memory" for the in-memory dev repo
# (default; data is lost on restart) or "sqlalchemy" for SQLite/Postgres.
PANELMIND_REPOSITORY=sqlalchemy

# Database URL. Defaults to SQLite in apps/api/data/panelmind.db.
# For Postgres: postgresql+asyncpg://user:pass@host:5432/panelmind
DATABASE_URL=sqlite+aiosqlite:///./apps/api/data/panelmind.db

# ─── LLM providers ───────────────────────────────────────────────
# PanelMind will fall back to the next available provider if one
# fails. Set at least ONE of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama runs locally. No key needed. Just run `ollama serve` first.
OLLAMA_BASE_URL=http://localhost:11434

# ─── NextAuth OAuth (web app) ────────────────────────────────────
# Generate at:
#   Google:  https://console.cloud.google.com/apis/credentials
#   GitHub:  https://github.com/settings/developers
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Comma-separated list of emails allowed to sign in. Empty = allow all.
PANELMIND_ALLOWED_EMAILS=

# ─── Optional integrations ────────────────────────────────────────
# Web search (Tavily has a generous free tier; DuckDuckGo is the
# fallback and requires no key).
TAVILY_API_KEY=

# Embeddings for pitch history similarity search (Jina or OpenAI).
JINA_API_KEY=
# OPENAI_API_KEY is also used for OpenAI embeddings if Jina is unset.

# Supabase / Postgres for vector storage. Tier 0a uses SQLite only.
SUPABASE_DB_URL=

# ─── Agent personas ──────────────────────────────────────────────
# Path to the persona YAMLs. Defaults to apps/api/agents/personas/.
# Override to ship a custom persona set in a self-hosted deployment.
PANELMIND_PERSONAS_DIR=

# ─── Rate limiting ───────────────────────────────────────────────
# Set to "false" to disable entirely (not recommended in production).
RATE_LIMIT_ENABLED=true
# Max requests per minute per IP. Default 60.
RATE_LIMIT_PER_MINUTE=60

# ─── Observability (Tier 1) ─────────────────────────────────────
# Leave blank for now.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=